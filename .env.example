# Copy this file to .env and fill it in.

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Run `npm run chat-id` after messaging your bot to get this
TELEGRAM_CHAT_ID=

# The fomo.family handle to watch (from fomo.family/profile/<handle>)
FOMO_HANDLE=atrois7

# How often to check, in seconds
INTERVAL_SECONDS=60

# Set to false to watch the browser while it checks
HEADLESS=true
